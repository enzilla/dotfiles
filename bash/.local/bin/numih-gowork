#!/usr/bin/env bash
# Faz fetch dos clones usados pelo go.work e mostra quais estão atrás da origin/main.
# Só relata: não faz pull nem troca de branch.
set -uo pipefail
gw=$(go env GOWORK)
[ -z "$gw" ] || [ "$gw" = "off" ] && { echo "Sem go.work neste diretório." >&2; exit 1; }
base=$(dirname "$gw")

dirs=$(awk '/^use \(/{b=1;next} b&&/^\)/{b=0} b{print $1} /^use [^(]/{print $2}' "$gw")
printf '%-40s %-40s %6s %6s %s\n' CLONE BRANCH ATRAS FRENTE SUJO
for d in $dirs; do
  p=$(cd "$base" && realpath "$d")
  top=$(git -C "$p" rev-parse --show-toplevel 2>/dev/null) || { echo "$d: não é repositório git"; continue; }
  git -C "$top" fetch -q origin main 2>/dev/null
  br=$(git -C "$top" branch --show-current)
  read -r atras frente < <(git -C "$top" rev-list --left-right --count origin/main...HEAD 2>/dev/null | awk '{print $1, $2}')
  sujo=$([ -n "$(git -C "$top" status --porcelain)" ] && echo sim || echo "")
  aviso=""; [ "${atras:-0}" -gt 0 ] && aviso=" <-"
  printf '%-40s %-40s %6s %6s %s%s\n' "$d" "${br:-(detached)}" "${atras:-?}" "${frente:-?}" "$sujo" "$aviso"
done
