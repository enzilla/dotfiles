{
  "env": {
    "CLAUDE_MEM_TELEMETRY": "off",
    "CLAUDE_MEM_TELEMETRY_ERRORS": "off"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "code-review-excellence": "off",
    "go-code-review": "off",
    "improve-animations": "off",
    "omarchy": "off",
    "pick-ui-library": "off",
    "prototype": "off",
    "review-and-refactor": "off",
    "review-animations": "off",
    "simplifying-code": "off",
    "supabase-server": "off",
    "tdd": "off",
    "token-efficiency": "off",
    "typescript-react-reviewer": "off",
    "ui-ux-pro-max": "off",
    "vercel-react-best-practices": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/enzo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/enzo/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "effortLevel": "low",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(numih-squash:*) in /home/enzo/dev/modulos/hospitalar"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(make run-production:*) in /home/enzo/dev/modulos/hospitalar"
    ],
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: internal (Numih/hospitalar)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (protected); rulesets active: Default, Tag, migrations-up-to-date",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Source control**: The trusted repo (github.com/Numih/hospitalar) and its remote(s) only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: client/.env, client/.env.development, client/.env.development.example, client/rspack.prod.js, server/.env.example, and other .env/credential/secret files matched by .gitignore (*.key, *.token, credentials.json, secrets.yaml, secrets.json); share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: /home/enzo/dev/modulos/hospitalar (github.com/Numih/hospitalar), internal visibility",
      "**Org-specific CLIs**: numih-squash (routine under this project)"
    ]
  },
  "workflowKeywordTriggerEnabled": false
}
