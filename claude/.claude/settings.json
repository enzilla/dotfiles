{
  "env": {
    "CLAUDE_MEM_TELEMETRY": "off",
    "CLAUDE_MEM_TELEMETRY_ERRORS": "off",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__computer",
      "mcp__claude-in-chrome__browser_batch",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__claude-in-chrome__form_input",
      "Bash(balena device:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "code-review-excellence": "off",
    "go-code-review": "off",
    "improve-animations": "off",
    "omarchy": "off",
    "pick-ui-library": "off",
    "prototype": "off",
    "review-and-refactor": "off",
    "review-animations": "off",
    "simplifying-code": "off",
    "supabase-server": "off",
    "tdd": "off",
    "token-efficiency": "off",
    "typescript-react-reviewer": "off",
    "ui-ux-pro-max": "off",
    "vercel-react-best-practices": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/enzo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/enzo/.claude/hooks/guardas-pessoais.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash /home/enzo/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true,
    "autoharness@autoharness": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "autoharness": {
      "source": {
        "source": "github",
        "repo": "tigerless-labs/autoharness"
      }
    }
  },
  "effortLevel": "low",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false
}
